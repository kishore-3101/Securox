# Securox — Environment Configuration Template
# Copy this file to .env and customize as needed:
# cp .env.example .env

# ── Application & Server ────────────────────────────────────────────────
SECUROX_ENV=production
HOST=0.0.0.0
PORT=8000
WORKERS=1
LOG_LEVEL=info
SECRET_KEY=securox-super-secret-command-center-token-key-2026-sh-fin-05

# ── Persistence & Storage ───────────────────────────────────────────────
# SQLite WAL database for local MVP; compatible with PostgreSQL
SECUROX_DB_PATH=backend/database/securox.db
TRAFFIC_DB_PATH=backend/traffic_core/traffic.db

# ── Risk Engine & Configuration ─────────────────────────────────────────
RISK_CONFIG_PATH=risk/config.yaml
ALERT_THRESHOLD_RISK=40.0
ALERT_THRESHOLD_ANOMALY=0.5

# ── Machine Learning & Telemetry ────────────────────────────────────────
IF_CONTAMINATION=0.05
RANDOM_SEED=42
TELEMETRY_SPEED=1.0

# ── Threat Intelligence Feeds ───────────────────────────────────────────
# Optional: External API key for VirusTotal / AbuseIPDB integration.
# If empty, Securox seamlessly uses the internal offline curated IOC dataset.
THREAT_INTEL_API_KEY=

# ── CCTV & Hardware Decoys ──────────────────────────────────────────────
ENABLE_HARDWARE_ATTESTATION=true
ENABLE_CANARY_HONEYPOTS=true
ENABLE_MERKLE_VAULT=true

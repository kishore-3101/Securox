# ==============================================================================
# SECUROX WEB — PRODUCTION MULTI-STAGE DOCKERFILE
# Stage 1: Build React SPA bundle via Node.js
# Stage 2: Serve optimized assets with Nginx Alpine reverse proxy
# ==============================================================================

# ── Stage 1: Build Environment ────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Install build dependencies
COPY package.json package-lock.json* ./
RUN npm install

# Copy source code and compile Vite bundle
COPY . .
RUN npm run build

# ── Stage 2: Production Web Server ────────────────────────────────────────────
FROM nginx:1.25-alpine AS runner

# Remove default nginx welcome site
RUN rm -rf /usr/share/nginx/html/*

# Copy compiled static assets from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy optimized SPA nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

# Production Container Healthcheck
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:80/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]

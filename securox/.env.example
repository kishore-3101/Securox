# ==============================================================================
# SECUROX UNIFIED CYBER-PHYSICAL PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# NEVER COMMIT REAL SECRETS, PRIVATE KEYS, OR CREDENTIALS TO GIT.
# Copy this template to .env before starting containers:
#   cp .env.example .env
#
# Generate strong 256-bit random secrets for production:
#   openssl rand -hex 32
# ==============================================================================

# ── Application Runtime Environment ───────────────────────────────────────────
# Options: production | development | testing
# In 'production' mode, startup will FAIL SAFELY if required secrets are absent.
SECUROX_ENV=production
LOG_LEVEL=info
HOST=0.0.0.0
PORT=8000
WEB_PORT=80
SSL_PORT=443
WORKERS=2

# ── Cryptographic Secrets (CRITICAL) ──────────────────────────────────────────
# Minimum 32 characters. Used for JWT digital signing, HMAC integrity, and session tokens.
# IN PRODUCTION: Generate using `openssl rand -hex 32` (Do NOT leave default/placeholder!)
SECRET_KEY=replace_with_openssl_generated_32_byte_hex_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Persistent Relational Database (PostgreSQL) ────────────────────────────────
# Used by securox-db and securox-api services.
POSTGRES_DB=securox
POSTGRES_USER=securox_user
# IN PRODUCTION: Use a high-entropy database password
POSTGRES_PASSWORD=replace_with_strong_database_password_in_production
POSTGRES_PORT=5432
DATABASE_URL=postgresql://securox_user:${POSTGRES_PASSWORD}@securox-db:5432/securox

# Database Connection Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30.0

# ── In-Memory Event Streaming, Cache & Pub/Sub (Redis) ────────────────────────
# Used by securox-redis and securox-api for central event bus and real-time state.
REDIS_PORT=6379
# IN PRODUCTION: Use a high-entropy Redis authentication password
REDIS_PASSWORD=replace_with_strong_redis_password_in_production
REDIS_URL=redis://:${REDIS_PASSWORD}@securox-redis:6379/0

# ── Cyber-Risk Engine & Safety Guard ──────────────────────────────────────────
RISK_CONFIG_PATH=risk/config.yaml
ALERT_THRESHOLD_RISK=40.0
ALERT_THRESHOLD_ANOMALY=0.5
TELEMETRY_SPEED=1.0
IF_CONTAMINATION=0.05
RANDOM_SEED=42

# ── Threat Intelligence & Security Decoys ─────────────────────────────────────
# Optional: External API key for VirusTotal / AbuseIPDB integration.
# Leave blank to seamlessly utilize the curated offline IOC knowledgebase.
THREAT_INTEL_API_KEY=
ENABLE_HARDWARE_ATTESTATION=true
ENABLE_CANARY_HONEYPOTS=true
ENABLE_MERKLE_VAULT=true
ENABLE_SAFETY_GUARD=true

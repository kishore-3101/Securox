# Copy to .env and fill in for local/dev use. Never commit the real .env.

APP_ENV=development
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000

# Paths (override if not using the default project layout)
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
ARTIFACTS_DIR=artifacts

# Reproducibility
RANDOM_SEED=42

# Model serving
MODEL_REGISTRY_DIR=artifacts/models
PREPROCESSOR_REGISTRY_DIR=artifacts/preprocessors

# Optional: object storage / DB for later smart-city subsystem integration
# DATABASE_URL=
# S3_BUCKET=
# S3_REGION=
